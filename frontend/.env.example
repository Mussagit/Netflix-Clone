# Backend API Endpoint:
# - Unified Vercel / Single-Link deployment: Leave empty (automatically uses /api on the live link)
# - Local Development: Leave empty or set to http://localhost:5000/api
# - External Backend (Render/Railway): Set to https://your-backend.onrender.com/api
VITE_BACKEND_URL=

