PORT=5000
NODE_ENV=production
JWT_SECRET=your_jwt_secret_key_here
TMDB_API_KEY=your_tmdb_api_key_v3
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration (MySQL / TiDB / PlanetScale / AWS RDS / Clever Cloud / Railway)
# Option A: Full Connection URI (Recommended for cloud databases)
# DATABASE_URL=mysql://user:password@host:port/database

# Option B: Individual Parameters
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=netflix_db
DB_PORT=3306
DB_SSL=true

# Allowed CORS Origins (comma-separated for production)
ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app,http://localhost:5173
